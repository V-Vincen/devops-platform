import groovy.json.JsonOutput

def notifyPlatform(String status, String failureSummary = null) {
    if (!params.CALLBACK_URL?.trim()) {
        echo '未提供平台回调地址，跳过状态回写。'
        return
    }
    def payload = JsonOutput.toJson([
        projectId      : params.PROJECT_ID.toLong(),
        serviceId      : params.SERVICE_ID.toLong(),
        pipelineRunId  : params.PIPELINE_RUN_ID.toLong(),
        status         : status,
        jobName        : env.JOB_NAME,
        buildNumber    : env.BUILD_NUMBER.toLong(),
        buildUrl       : env.BUILD_URL,
        failureSummary : failureSummary,
        imageRepository: status == 'SUCCESS' ? params.IMAGE_REPOSITORY : null,
        imageTag       : status == 'SUCCESS' ? env.RESOLVED_IMAGE_TAG : null,
        imageDigest    : status == 'SUCCESS' ? env.RESOLVED_IMAGE_DIGEST : null,
        deploymentStatus: env.DEPLOYMENT_STATUS ?: null,
        helmReleaseName: env.DEPLOYMENT_STATUS ? params.HELM_RELEASE_NAME : null,
        helmRevision: env.DEPLOYMENT_REVISION ? env.DEPLOYMENT_REVISION.toInteger() : null
    ])
    writeFile file: '.devops-callback.json', text: payload
    withCredentials([string(credentialsId: 'devops-jenkins-callback-secret', variable: 'DEVOPS_CALLBACK_SECRET')]) {
        sh '''#!/bin/sh
            set -eu
            set +x
            signature="$(openssl dgst -sha256 -hmac "$DEVOPS_CALLBACK_SECRET" .devops-callback.json | awk '{print $NF}')"
            curl --fail --silent --show-error \
              -H 'Content-Type: application/json' \
              -H "X-DevOps-Signature: sha256=${signature}" \
              --data-binary @.devops-callback.json \
              "$CALLBACK_URL"
        '''
    }
}

pipeline {
    // 控制器不执行构建，避免 Maven、Docker 和集群工具扩大控制器权限。
    agent { label 'devops-build' }

    options {
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'PROJECT_ID', defaultValue: '', description: 'DevOps 平台项目 ID')
        string(name: 'SERVICE_ID', defaultValue: '', description: 'DevOps 平台微服务 ID')
        string(name: 'PIPELINE_RUN_ID', defaultValue: '', description: 'DevOps 平台构建记录 ID')
        string(name: 'REPOSITORY_URL', defaultValue: '', description: 'Git 仓库地址')
        string(name: 'GIT_CREDENTIALS_ID', defaultValue: '', description: 'Jenkins Git SSH 凭据 ID')
        string(name: 'GIT_REF', defaultValue: 'refs/heads/main', description: 'Git 分支引用')
        string(name: 'COMMIT_SHA', defaultValue: '', description: '期望构建的提交号')
        choice(name: 'BUILD_TYPE', choices: ['MAVEN'], description: '当前支持的构建类型')
        string(name: 'BUILD_WORKDIR', defaultValue: '.', description: '仓库内构建目录')
        string(name: 'DOCKERFILE_PATH', defaultValue: 'Dockerfile', description: '仓库内 Dockerfile 路径')
        string(name: 'DOCKER_CONTEXT_PATH', defaultValue: '.', description: '仓库内 Docker 构建上下文')
        string(name: 'IMAGE_REPOSITORY', defaultValue: '', description: '目标镜像仓库')
        string(name: 'ENVIRONMENT_CODE', defaultValue: '', description: '平台目标环境编码')
        string(name: 'CALLBACK_URL', defaultValue: '', description: 'DevOps 平台 Jenkins 回调地址')
        booleanParam(name: 'DEPLOY_ENABLED', defaultValue: false, description: '仅在提供 Helm 定义后启用部署')
        string(name: 'HELM_CHART_PATH', defaultValue: '', description: '仓库内 Helm Chart 路径')
        string(name: 'HELM_RELEASE_NAME', defaultValue: '', description: 'Helm Release 名称')
        string(name: 'K8S_NAMESPACE', defaultValue: '', description: '目标 Kubernetes Namespace')
        string(name: 'IMAGE_PULL_REPOSITORY', defaultValue: '', description: '部署拉取地址；为空时使用推送地址')
    }

    environment {
        REGISTRY_HOST = 'host.docker.internal:18082'
        MAVEN_PUBLIC_URL = 'http://host.docker.internal:18081/repository/maven-public/'
        MAVEN_RELEASES_URL = 'http://host.docker.internal:18081/repository/maven-releases/'
        MAVEN_SNAPSHOTS_URL = 'http://host.docker.internal:18081/repository/maven-snapshots/'
        MAVEN_SETTINGS_PATH = "${WORKSPACE}@tmp/devops-maven-settings.xml"
    }

    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    // 业务仓库检出会覆盖工作区；先保留平台管理的 Maven 配置，文件仅含环境变量引用。
                    writeFile file: env.MAVEN_SETTINGS_PATH, text: readFile('infra/jenkins/settings.xml.example')
                    def positiveId = { value -> value?.trim() ==~ /[1-9][0-9]*/ }
                    def safePath = { value -> value?.trim() == '.' || (value?.trim() ==~ /[A-Za-z0-9][A-Za-z0-9._\/-]*/ && !value.contains('..') && !value.startsWith('/')) }
                    if (!positiveId(params.PROJECT_ID) || !positiveId(params.SERVICE_ID) || !positiveId(params.PIPELINE_RUN_ID)) {
                        error('PROJECT_ID、SERVICE_ID 和 PIPELINE_RUN_ID 必须是正整数。')
                    }
                    def repositoryUrl = params.REPOSITORY_URL?.trim()
                    def httpsRepository = repositoryUrl ==~ /https?:\/\/[A-Za-z0-9._~:\/-]+(?:\.git)?/
                    def sshRepository = repositoryUrl ==~ /git@[A-Za-z0-9.-]+:[A-Za-z0-9._~\/-]+(?:\.git)?/
                    if (!httpsRepository && !sshRepository) {
                        error('REPOSITORY_URL 必须是 HTTPS 或 SSH Git 地址。')
                    }
                    if (sshRepository && !params.GIT_CREDENTIALS_ID?.trim()) {
                        error('SSH 仓库必须提供 GIT_CREDENTIALS_ID。')
                    }
                    if (!(params.GIT_REF?.trim() ==~ /refs\/heads\/[A-Za-z0-9._\/-]+/)) {
                        error('GIT_REF 只能是分支引用。')
                    }
                    if (!safePath(params.BUILD_WORKDIR) || !safePath(params.DOCKERFILE_PATH) || !safePath(params.DOCKER_CONTEXT_PATH)) {
                        error('构建目录、Dockerfile 和构建上下文必须是仓库内安全相对路径。')
                    }
                    if (!(params.IMAGE_REPOSITORY?.trim() ==~ /[A-Za-z0-9][A-Za-z0-9.\/:\-]{0,499}/)) {
                        error('IMAGE_REPOSITORY 格式不正确。')
                    }
                    def requestedTag = params.COMMIT_SHA?.trim()
                    if (requestedTag && !(requestedTag ==~ /[A-Za-z0-9][A-Za-z0-9._-]{0,127}/)) {
                        error('COMMIT_SHA 仅允许字母、数字、点、下划线和连字符。')
                    }
                    env.RESOLVED_IMAGE_TAG = requestedTag ? requestedTag.take(128) : env.BUILD_NUMBER
                    env.IMAGE_REFERENCE = "${params.IMAGE_REPOSITORY}:${env.RESOLVED_IMAGE_TAG}"
                }
            }
        }

        stage('Notify Running') {
            steps {
                script { notifyPlatform('RUNNING') }
            }
        }

        stage('Checkout') {
            steps {
                script {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: params.GIT_REF]],
                        userRemoteConfigs: [[
                            url: params.REPOSITORY_URL,
                            credentialsId: params.GIT_CREDENTIALS_ID?.trim() ?: null
                        ]]
                    ])
                    if (params.COMMIT_SHA?.trim()) {
                        sh "git checkout --detach '${params.COMMIT_SHA}'"
                    }
                }
            }
        }

        stage('Maven Test') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'nexus-maven-publish',
                    usernameVariable: 'NEXUS_MAVEN_USERNAME',
                    passwordVariable: 'NEXUS_MAVEN_PASSWORD'
                )]) {
                    dir(params.BUILD_WORKDIR) {
                        sh 'mvn -s "$MAVEN_SETTINGS_PATH" -B clean verify'
                    }
                }
            }
        }

        stage('Publish Maven Artifact') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'nexus-maven-publish',
                    usernameVariable: 'NEXUS_MAVEN_USERNAME',
                    passwordVariable: 'NEXUS_MAVEN_PASSWORD'
                )]) {
                    dir(params.BUILD_WORKDIR) {
                        sh '''#!/bin/sh
                            set -eu
                            mvn -s "$MAVEN_SETTINGS_PATH" -B -DskipTests deploy \
                              -DaltReleaseDeploymentRepository=nexus-releases::${MAVEN_RELEASES_URL} \
                              -DaltSnapshotDeploymentRepository=nexus-snapshots::${MAVEN_SNAPSHOTS_URL}
                        '''
                    }
                }
            }
        }

        stage('Build and Push Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'nexus-docker-push',
                    usernameVariable: 'NEXUS_DOCKER_USERNAME',
                    passwordVariable: 'NEXUS_DOCKER_PASSWORD'
                )]) {
                    sh '''#!/bin/sh
                        set -eu
                        set +x
                        printf '%s' "$NEXUS_DOCKER_PASSWORD" | docker login "$REGISTRY_HOST" -u "$NEXUS_DOCKER_USERNAME" --password-stdin
                        docker build --file "$DOCKERFILE_PATH" -t "$IMAGE_REFERENCE" "$DOCKER_CONTEXT_PATH"
                        docker push "$IMAGE_REFERENCE"
                        digest="$(docker image inspect "$IMAGE_REFERENCE" --format '{{index .RepoDigests 0}}')"
                        case "$digest" in
                          *@sha256:*) printf '%s' "${digest#*@}" > .devops-image-digest ;;
                          *) echo '未获取到镜像 Digest。' >&2; exit 2 ;;
                        esac
                    '''
                    script { env.RESOLVED_IMAGE_DIGEST = readFile('.devops-image-digest').trim() }
                }
            }
        }

        stage('Deploy to K3s') {
            when { expression { return params.DEPLOY_ENABLED } }
            steps {
                script {
                    if (!params.HELM_CHART_PATH?.trim() || !params.HELM_RELEASE_NAME?.trim() || !params.K8S_NAMESPACE?.trim()) {
                        error('启用部署时必须提供 HELM_CHART_PATH、HELM_RELEASE_NAME 和 K8S_NAMESPACE。')
                    }
                }
                withCredentials([file(credentialsId: 'k3s-kubeconfig', variable: 'K3S_KUBECONFIG')]) {
                    withEnv(['HELM_DRIVER=configmap',
                             "DEPLOY_IMAGE_REPOSITORY=${params.IMAGE_PULL_REPOSITORY?.trim() ?: params.IMAGE_REPOSITORY}"]) {
                        script { env.DEPLOYMENT_STATUS = 'FAILED' }
                        sh '''#!/bin/sh
                            set -eu
                            export KUBECONFIG="$K3S_KUBECONFIG"
                            helm upgrade --install "$HELM_RELEASE_NAME" "$HELM_CHART_PATH" \
                              --namespace "$K8S_NAMESPACE" \
                              --set image.repository="$DEPLOY_IMAGE_REPOSITORY" \
                              --set-string image.tag="${RESOLVED_IMAGE_TAG}@${RESOLVED_IMAGE_DIGEST}" \
                              --wait --timeout 5m
                            helm history "$HELM_RELEASE_NAME" --namespace "$K8S_NAMESPACE" --max 1 | awk 'NR==2 {print $1}' > .devops-helm-revision
                        '''
                        script {
                            env.DEPLOYMENT_REVISION = readFile('.devops-helm-revision').trim()
                            env.DEPLOYMENT_STATUS = 'SUCCESS'
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            script { notifyPlatform('SUCCESS') }
        }
        failure {
            // 镜像发布成功后的部署失败单独记录，保留可用于重试或回滚的镜像。
            script { notifyPlatform(env.DEPLOYMENT_STATUS ? 'SUCCESS' : 'FAILED', "Jenkins 构建或部署 #${env.BUILD_NUMBER} 失败") }
        }
        always {
            archiveArtifacts artifacts: '**/target/*.jar', allowEmptyArchive: true
        }
    }
}
