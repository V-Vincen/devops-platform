# 固定 Jenkins LTS 版本，禁止使用 latest 或浮动 lts 标签。
JENKINS_IMAGE=jenkins/jenkins:2.580.1-lts-jdk21

# 本机开发仅通过回环地址访问，避免控制器在局域网暴露。
JENKINS_BIND_ADDRESS=127.0.0.1
JENKINS_HTTP_PORT=18090

# Jenkins Home 保存 Job、插件、凭据引用和构建记录。
JENKINS_HOME_VOLUME=devops-jenkins-home

# 专用构建 Agent 默认不启动；完成 Jenkins 节点注册后，将对应 JNLP 密钥仅写入本机 .env。
JENKINS_AGENT_IMAGE=devops-jenkins-agent:local
JENKINS_AGENT_NAME=devops-build
JENKINS_AGENT_SECRET=
