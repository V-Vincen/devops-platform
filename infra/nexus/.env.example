# 固定镜像版本，避免 latest 自动升级导致仓库数据或 API 兼容性变化。
NEXUS_IMAGE=sonatype/nexus3:3.96.3-alpine

# 本期只提供本机访问；迁移到测试服务器时改为服务器 IP 或 0.0.0.0，并在前面配置 HTTPS 反向代理。
NEXUS_BIND_ADDRESS=127.0.0.1

# 以下两个地址分别供初始化脚本和 Nexus 容器使用，不能互换。
NEXUS_DB_BOOTSTRAP_HOST=127.0.0.1
NEXUS_DB_BOOTSTRAP_PORT=15432
NEXUS_DATASTORE_NEXUS_JDBCURL=jdbc:postgresql://host.docker.internal:15432/nexus?currentSchema=nexus

# Nexus 元数据独立于 devops_platform；密码必须使用随机强密码，且不能提交到版本控制。
NEXUS_DB_NAME=nexus
NEXUS_DB_USER=nexus
NEXUS_DB_PASSWORD=请替换为随机强密码
NEXUS_DB_SCHEMA=nexus
NEXUS_DB_MAX_POOL_SIZE=10

# 首次初始化后用于替换 Nexus 临时管理员密码；同样必须使用随机强密码。
NEXUS_ADMIN_PASSWORD=请替换为随机强密码

# 供后续 Jenkins 和 K3s 使用的最小权限账号密码；分别设置不同的随机强密码。
JENKINS_PUBLISHER_PASSWORD=请替换为随机强密码
K3S_PULLER_PASSWORD=请替换为随机强密码

# Docker Desktop 约 8 GB 时采用 Nexus 官方允许的最小 JVM 配置。
NEXUS_JVM_HEAP=2703m
NEXUS_JVM_DIRECT_MEMORY=2703m
